# dependencies (installed fresh in the Dockerfile's deps/deps-prod stages)
node_modules
**/node_modules

# vite build output (regenerated by the build stage)
dist
**/dist

# env files -- never bake secrets into the image; .env.example is a template only, and
# real values are injected at runtime via the hosting platform
.env
.env.*
!.env.example

# test artifacts and tooling
coverage
test-results
*.test.ts
*.test.tsx

# IDE / OS
.vscode
.idea
*.swp
*.swo
.DS_Store

# git
.git
.gitignore
.gitattributes

# CI/CD (not needed inside the image)
.github

# docs
README.md
docs
*.md

# docker itself
Dockerfile
.dockerignore

# misc build artifacts
*.tsbuildinfo

# subagent-driven-development scratch space
.superpowers
.claude
