{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // TypeScript 7 defaults `types` to [], so ambient types must be listed explicitly.
    "types": ["vite/client"]
  },
  "include": ["client", "shared", "vite.config.ts"]
}
