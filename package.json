{
  "name": "pointing-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.ts",
    "build": "vite build",
    "start": "node server/index.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "tsc:check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "image:build": "scripts/docker-build.sh",
    "image:push": "scripts/docker-push.sh",
    "image:run": "scripts/docker-run.sh"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@fastify/vite": "^10.0.0",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
